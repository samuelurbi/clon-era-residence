# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# gemelo Vite para GoHighLevel Vibe: el código SÍ se versiona (es lo que se
# pega en el editor y se quiere poder diffear), pero no sus dependencias ni
# su build. Ver vibe/README.md.
/vibe/node_modules
/vibe/dist
/vibe-bundle/node_modules
/vibe-bundle/dist
/vibe-bundle/.progreso

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/vibe-bundle/.pegado.json

# material bruto del cliente (renders, zips, capturas de QA): pesa GB, vive
# fuera de git. Solo se versionan el brief y los inventarios.
/bahia-mar-personalizacion/*
!/bahia-mar-personalizacion/BRIEF.md
!/bahia-mar-personalizacion/INVENTARIO-IMAGENES.md
!/bahia-mar-personalizacion/INVENTARIO-IMAGENES.json
!/bahia-mar-personalizacion/inventario/

# capturas HAR de GHL (~80 MB, llevan tokens de sesión)
*.har

# snapshot de GHL Vibe y los diffs de sincronización (regenerables desde el HAR)
/referencia-ghl/
