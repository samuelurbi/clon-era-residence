# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# gemelo Vite para GoHighLevel Vibe: el código SÍ se versiona (es lo que se
# pega en el editor y se quiere poder diffear), pero no sus dependencias ni
# su build. Ver vibe/README.md.
/vibe/node_modules
/vibe/dist
/vibe-bundle/node_modules
/vibe-bundle/dist
/vibe-bundle/.progreso

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/vibe-bundle/.pegado.json

# Material del cliente para la personalización de Bahía Mar (13 GB de renders,
# brochure y vídeos): fuera del repositorio. Sólo se versionan el brief y los
# inventarios de imágenes usadas; las capturas de QA no.
/bahia-mar-personalizacion/*
!/bahia-mar-personalizacion/BRIEF.md
!/bahia-mar-personalizacion/INVENTARIO-IMAGENES.json
!/bahia-mar-personalizacion/INVENTARIO-IMAGENES.md
!/bahia-mar-personalizacion/inventario/

# Capturas y miniaturas que dejan los scripts de QA en scratchpad/: se
# versionan los scripts, no sus resultados.
/scratchpad/**/*.png
/scratchpad/**/*.jpg
/scratchpad/**/*.jpeg
/scratchpad/**/*.webp
